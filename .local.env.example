# Copy only after replacing placeholders, or use scripts/local-config.mjs.
# This file contains no working credentials.
FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
FOUNDRY_JUDGE_DEPLOYMENT="gpt-6-astra"
FOUNDRY_CHAT_DEPLOYMENT="gpt-6-luna"
FOUNDRY_RUBRIC_NAME="<registered-rubric-name>"
FOUNDRY_RUBRIC_VERSION="<registered-version>"
JOB_SIGNING_KEY="<generate-a-random-value-of-at-least-32-characters>"
LIVE_CALLS_ENABLED="false"
LOCAL_AZURE_CLI_CREDENTIAL="true"

# Deployment uses a server-side application identity, not a visitor login.
# Put real values only in ignored local settings and encrypted Azure settings.
# FOUNDRY_TENANT_ID="<tenant-id>"
# FOUNDRY_CLIENT_ID="<application-id>"
# FOUNDRY_CLIENT_SECRET="<application-secret>"
